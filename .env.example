# --- Database (PostgreSQL) ---
# Usato da Prisma. In locale punta al container docker-compose.
DATABASE_URL="postgresql://ale_onlus:ale_onlus@localhost:5432/ale_onlus?schema=public"

# --- Auth.js (NextAuth v5) ---
# Genera un valore con: npx auth secret  (oppure: openssl rand -base64 32)
AUTH_SECRET="changeme-generate-a-random-secret"

# URL pubblico dell'app, richiesto in produzione da Auth.js
AUTH_URL="http://localhost:3000"

# --- Admin di bootstrap (usato dallo script di seed) ---
SEED_ADMIN_EMAIL="admin@ilsognodiale.it"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Amministratore"
