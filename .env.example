# --- Database (PostgreSQL) ---
# Usato da Prisma. In locale punta al container docker-compose.
DATABASE_URL="postgresql://ale_onlus:ale_onlus@localhost:5432/ale_onlus?schema=public"

# --- Auth.js (NextAuth v5) ---
# Genera un valore con: npx auth secret  (oppure: openssl rand -base64 32)
AUTH_SECRET="changeme-generate-a-random-secret"

# URL pubblico dell'app, richiesto in produzione da Auth.js
AUTH_URL="http://localhost:3000"

# --- Google OAuth (opzionale) ---
# Se vuote, il pulsante "Accedi/Registrati con Google" non viene mostrato.
# Crea le credenziali su https://console.cloud.google.com/apis/credentials
# (tipo "ID client OAuth", applicazione web) e aggiungi tra gli URI di
# reindirizzamento autorizzati: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Banner donazioni PayPal (opzionale) ---
# Link di donazione PayPal (es. https://www.paypal.com/donate/?hosted_button_id=XXXX).
# Se vuoto, il banner porta alla pagina /dona. Con Docker serve rifare la build.
NEXT_PUBLIC_PAYPAL_DONATE_URL=""

# --- Admin di bootstrap (usato dallo script di seed) ---
SEED_ADMIN_EMAIL="admin@ilsognodiale.it"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Amministratore"
